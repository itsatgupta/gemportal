# =============================================================================
# ANAMAC Bid Proposal Intelligence Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# =============================================================================

# --- AI / LLM API Key (DeepSeek) ---
# Required: DeepSeek API key — used by Agent 2, Agent 3, and scope analysis
# Get one at: https://platform.deepseek.com/ (cheaper than Anthropic, OpenAI-compatible)
DEEPSEEK_API_KEY=sk-...

# DeepSeek model: deepseek-chat (V3, default) or deepseek-reasoner (R1)
# DEEPSEEK_MODEL=deepseek-chat

# DeepSeek API base URL (change only if DeepSeek relocates it)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- GEM Portal ---
# The Government e-Marketplace bid listing URL (Agent 1 scrapes this)
GEM_PORTAL_URL=https://bidplus.gem.gov.in/all-bids

# --- Directory Paths ---
# Where downloaded bid documents are stored (relative to project root)
BIDS_BASE_DIR=./bids

# Where your company's supporting documents are stored (certifications, past projects, etc.)
BID_SUPPORTING_DOCS_DIR=./bidsupportingdocs

# --- Server URLs ---
# Frontend dev server URL (Vite default)
FRONTEND_URL=http://localhost:5173

# Backend API server URL (FastAPI/uvicorn)
BACKEND_URL=http://localhost:8000

# --- CORS ---
# Comma-separated list of allowed origins (defaults to FRONTEND_URL + localhost)
# For production, set to your actual frontend domain only
# ALLOWED_ORIGINS=https://yourdomain.com

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
# Log format: "console" for development, "json" for production (default: console)
# LOG_FORMAT=json

# --- Download Settings ---
# Number of retry attempts for failed document downloads
MAX_DOWNLOAD_RETRIES=3

# Timeout in seconds for each document download
DOWNLOAD_TIMEOUT_SECONDS=60
